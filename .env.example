# Lokalni primer imena. Ne upisivati vrednosti u git.
# Prave vrednosti stoje samo u okruženju ili u GitHub Secrets.
# Sportske ključeve ne stavljati u Vite promenljive: one ulaze u browser.

# Besplatan nalog na https://dashboard.api-football.com (kartica nije potrebna).
# Isti nalog pokriva fudbal i košarku, ali svaki API ima sopstveni ključ u dashboard-u.
# Zaglavlje: x-apisports-key
# Fudbal: https://v3.football.api-sports.io
# Košarka: https://v1.basketball.api-sports.io
APISPORTS_FOOTBALL_KEY=
APISPORTS_BASKETBALL_KEY=

# Besplatan registrovani token, zaglavlje X-Auth-Token.
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# TheSportsDB javni test ključ je objavljen u njihovoj dokumentaciji kao 123.
# Ne čuvati ga kao tajnu. Plaćeni ključ nije deo budžeta od 0 €.
# THESPORTSDB_KEY=123

# Faza 02. Vrednosti idu u Cloudflare Workers secrets ili lokalni .dev.vars.
# Ne stavljati ih u PWA, config.json ni u Vite promenljive.
# PROBE_SEND_ENABLED=1 otvara probni endpoint. Bez toga rute vraćaju 404.
# FCM_PRIVATE_KEY je PKCS8 PEM. U jednom redu koristi \n umesto pravog novog reda.
# Javni web ključ i VAPID javni ključ nisu ovde: prazni su u experiments/push-probe/pwa/config.json.
PROBE_SEND_ENABLED=
PROBE_ENROLL_SECRET=
FIREBASE_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
PUBLIC_BASE_URL=

# Javna web konfiguracija Firebase projekta. Nisu admin tajne.
# Vrednosti ne upisivati u git. Bez ovih promenljivih klijent ostaje nepodešen.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# Samo lokalni emulator, nikad javni host:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Faza 05. Servis experiments/schedule-service. Ne stavljati token u URL ni u Vite.
# FIREBASE_PROJECT_ID je već gore, u fazi 02. Isti projekat proverava ID token.
# SCHEDULE_MODE=synthetic nije dozvoljen kada je NODE_ENV=production.
# Lokalna proba: node --experimental-strip-types experiments/schedule-service/src/main.ts
# Deploy cilj je Worker matchahead-schedule. Ovaj zadatak ga ne postavlja.
SCHEDULE_MODE=
SCHEDULE_BIND_HOST=127.0.0.1
SCHEDULE_PORT=8787
SCHEDULE_STORE_DIR=
SCHEDULE_ALLOWED_ORIGINS=
SCHEDULE_TRUST_PROXY=
# Rok čitanja tela i sertifikata, u milisekundama. Prazno znači 5000.
# SCHEDULE_LAB_URL, SCHEDULE_LAB_KIND i SCHEDULE_LAB_PARSER samo za sintetički test.
SCHEDULE_IO_TIMEOUT_MS=
