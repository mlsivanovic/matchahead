{
  "name": "@matchahead/push-probe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Izolovana proba FCM push-a dok je PWA zatvorena. Nema sportskih podataka i ne šalje iz pregledača.",
  "scripts": {
    "check": "node --experimental-strip-types --test test/*.test.ts",
    "build:client": "node scripts/build-client.mjs",
    "measure": "node scripts/measure-cpu.mjs",
    "serve": "node --experimental-strip-types scripts/serve.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20260926.0-alpha",
    "wrangler": "4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
