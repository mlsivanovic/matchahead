{
  // Produkcija koristi samo eksplicitno odobrene javne izvore; nema laboratorijskih URL-ova.
  // Ne dirati worker matchahead-push-probe. Ovaj zadatak ne menja naplatu niti nalog.
  "name": "matchahead-schedule",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "vars": {
    "FIREBASE_PROJECT_ID": "matchahead",
    "NODE_ENV": "production",
    "SCHEDULE_MODE": "production",
    "SCHEDULE_ALLOWED_ORIGINS": "https://mlsivanovic.github.io",
    "SCHEDULE_APPROVED_PROVIDERS": "fss,aba-liga,euroleague",
    "SCHEDULE_PUBLIC_READ": "1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULE",
        "class_name": "ScheduleDirectoryObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-schedule-directory",
      "new_sqlite_classes": ["ScheduleDirectoryObject"]
    }
  ]
}
